<Window x:Class="ClimbingScore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClimbingScore"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button Content="Registrera" x:Name="btnOk" HorizontalAlignment="Left" Margin="93,57,0,0" VerticalAlignment="Top" Command="{Binding RegisterScoreCommand}" />
        <TextBox HorizontalAlignment="Left" Margin="93,25,0,0" TextWrapping="Wrap" Text="{Binding Name}" VerticalAlignment="Top" Width="120"/>
        <Label Content="namn" HorizontalAlignment="Left" Margin="95,0,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
