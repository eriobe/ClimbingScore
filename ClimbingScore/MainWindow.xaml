<Window
    x:Class="ClimbingScore.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ClimbingScore.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ClimbingScore"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="600"
    Height="750"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:GradeColorToSwedishConverter x:Key="GradeColorToSwedishConverter" />
        <converters:GradeColorToColorConverter x:Key="GradeColorToColorConverter" />
    </Window.Resources>
    <Grid Background="#F3F4F6">

        <Border
            Width="420"
            Padding="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            CornerRadius="12">

            <StackPanel>

                <TextBlock
                    Margin="0,0,0,30"
                    FontSize="28"
                    FontWeight="Bold"
                    Text="Poäng" />

                <TextBlock FontWeight="SemiBold" Text="Klättrare" />

                <TextBox
                    Margin="0,6,0,20"
                    Padding="8"
                    FontSize="18"
                    Text="{Binding ClimberName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock FontWeight="SemiBold" Text="Problem" />
                <TextBox Text="{Binding ProblemNumber, UpdateSourceTrigger=PropertyChanged}" />



                <TextBlock FontWeight="SemiBold" Text="Svårighetsgrad" />
                <TextBlock FontWeight="SemiBold" Text="{Binding DefaultGradeColor, Converter={StaticResource GradeColorToSwedishConverter}}" />

                <ComboBox
                    Margin="0,6,0,20"
                    Padding="8"
                    FontSize="18"
                    ItemsSource="{Binding GradeColors}"
                    SelectedItem="{Binding SelectedGrade, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse
                                    Width="16"
                                    Height="16"
                                    Fill="{Binding Converter={StaticResource GradeColorToColorConverter}}"
                                    Stroke="Black"
                                    StrokeThickness="1" />
                                <TextBlock Text="{Binding Converter={StaticResource GradeColorToSwedishConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>

                <TextBlock FontWeight="SemiBold" Text="Antal försök" />

                <Grid Margin="0,6,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Width="36"
                        Height="36"
                        Command="{Binding DecreaseAttemptsCommand}"
                        Content="−"
                        FontSize="16"
                        FontWeight="Bold" />

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="26"
                        FontWeight="SemiBold"
                        Text="{Binding Attempts}" />

                    <Button
                        Grid.Column="2"
                        Width="60"
                        Height="60"
                        Command="{Binding IncreaseAttemptsCommand}"
                        Content="+"
                        FontSize="30"
                        FontWeight="Bold"
                        IsEnabled="{Binding IsEnabled}" />
                </Grid>

                <Border
                    Margin="0,0,0,20"
                    Padding="16"
                    Background="#F3F4F6"
                    CornerRadius="8">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock
                                FontSize="13"
                                Foreground="Gray"
                                Text="Resultat" />

                            <TextBlock
                                FontSize="22"
                                FontWeight="SemiBold"
                                Text="{Binding ResultType}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock
                                FontSize="13"
                                Foreground="Gray"
                                Text="Poäng" />

                            <TextBlock
                                FontSize="22"
                                FontWeight="Bold"
                                Text="{Binding Score}" />
                        </StackPanel>
                    </Grid>

                </Border>

                <Button
                    Padding="12"
                    Command="{Binding RegisterScoreCommand}"
                    Content="Registrera"
                    FontSize="18"
                    FontWeight="SemiBold" />

            </StackPanel>

        </Border>

    </Grid>

</Window>
