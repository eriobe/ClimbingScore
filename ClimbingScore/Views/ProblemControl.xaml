<UserControl
    x:Class="ClimbingScore.Views.ProblemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ClimbingScore.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ClimbingScore.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:GradeColorToSwedishConverter x:Key="GradeColorToSwedish" />

        <converters:GradeColorToColorConverter x:Key="GradeColorToColorConverter" />
    </UserControl.Resources>

    <StackPanel>

        <TextBlock
            Margin="0,0,0,6"
            FontWeight="SemiBold"
            Text="Problem" />

        <TextBlock
            Margin="0,0,0,20"
            FontSize="24"
            FontWeight="SemiBold"
            Text="{Binding Number}" />


        <TextBlock FontWeight="SemiBold" Text="Svårighetsgrad" />

        <ComboBox
            Margin="0,6,0,20"
            Padding="8"
            FontSize="18"
            ItemsSource="{Binding GradeColors}"
            SelectedItem="{Binding Grade, Mode=TwoWay}">

            <ComboBox.ItemTemplate>
                <DataTemplate>

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                        <Ellipse
                            Width="16"
                            Height="16"
                            Margin="4,0,10,0"
                            VerticalAlignment="Center"
                            Fill="{Binding Converter={StaticResource GradeColorToColorConverter}}"
                            Stroke="Black"
                            StrokeThickness="1" />

                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="18"
                            Text="{Binding Converter={StaticResource GradeColorToSwedish}}" />

                    </StackPanel>

                </DataTemplate>
            </ComboBox.ItemTemplate>

        </ComboBox>


        <TextBlock FontWeight="SemiBold" Text="Antal försök" />

        <Grid Margin="0,6,0,25">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Width="36"
                Height="36"
                Command="{Binding DecreaseAttemptsCommand}"
                Content="−"
                FontSize="16"
                FontWeight="Bold" />

            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="26"
                FontWeight="SemiBold"
                Text="{Binding Attempts}" />

            <Button
                Grid.Column="2"
                Width="60"
                Height="60"
                Command="{Binding IncreaseAttemptsCommand}"
                Content="+"
                FontSize="30"
                FontWeight="Bold" />

        </Grid>


        <Border
            Margin="0,0,0,20"
            Padding="16"
            Background="#F3F4F6"
            CornerRadius="8">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock
                        FontSize="13"
                        Foreground="Gray"
                        Text="Resultat" />

                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Text="{Binding ResultType}" />

                </StackPanel>

                <StackPanel Grid.Column="1">

                    <TextBlock
                        FontSize="13"
                        Foreground="Gray"
                        Text="Poäng" />

                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Text="{Binding Score}" />

                </StackPanel>

            </Grid>

        </Border>

    </StackPanel>

</UserControl>
